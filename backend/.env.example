# Copy to backend/.env for local overrides. Every setting has a sensible default.
# No secrets are required: the Elexon Insights API is public.

# development | test | preview | production
APP_ENV=development
LOG_LEVEL=INFO

# http = live Elexon API; fixtures = recorded data (offline; not allowed in production)
SOURCE_MODE=http
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_CONNECT_TIMEOUT_S=3
HTTP_READ_TIMEOUT_S=10
UPSTREAM_MAX_RETRIES=1

CACHE_ENABLED=true
CACHE_TTL_S=21600
RATE_LIMIT_PER_MINUTE=60

# Default decision time: the day before delivery at 09:00 UK time
DEFAULT_CUTOFF_DAY_OFFSET=-1
DEFAULT_CUTOFF_LOCAL_TIME=09:00
SUPPORTED_DATE_FROM=2026-01-01
SUPPORTED_DATE_TO=2026-02-01
